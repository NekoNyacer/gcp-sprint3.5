{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "cms": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["zone.js"],
            "inlineStyleLanguage": "scss",
            "outputPath": "dist/cms",
            "assets": [
              { "glob": "**/*", "input": "public" },
              {
                "glob": "**/*",
                "input": "node_modules/cub-lib-view-utilities/images",
                "output": "assets/images"
              }
            ],
            "styles": [
              "node_modules/cub-lib-view-iconfont/css/cub-lib-view-iconfont.min.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": { "buildTarget": "cms:build:development" },
            "production": { "buildTarget": "cms:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
