rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid;
    }

    function isValidUserProfile() {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'displayName',
          'photoUrl',
          'dailyGoal',
          'onboardingStatus',
          'isDemo',
          'updatedAt',
          'taskAreaId',
          'treePoints',
          'totalMatureTrees'
        ])
        && data.keys().hasAll([
          'displayName',
          'photoUrl',
          'dailyGoal',
          'onboardingStatus',
          'isDemo',
          'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() <= 80
        && data.photoUrl is string
        && data.photoUrl.size() <= 500
        && data.dailyGoal is int
        && data.dailyGoal >= 1000
        && data.dailyGoal <= 30000
        && data.onboardingStatus in ['required', 'completed']
        && data.isDemo == false
        && (!('treePoints' in data)
          || (data.treePoints is int && data.treePoints >= 0))
        && (!('totalMatureTrees' in data)
          || (data.totalMatureTrees is int && data.totalMatureTrees >= 0))
        && data.updatedAt == request.time
        && (!('taskAreaId' in data) || data.taskAreaId in ['banqiao', 'xihu']);
    }

    function hasValidInitialShopSummary() {
      let data = request.resource.data;
      let hasLegacyShape = !('treePoints' in data)
        && !('totalMatureTrees' in data);
      let hasInitializedShopSummary = data.keys().hasAll([
          'treePoints',
          'totalMatureTrees'
        ])
        && data.treePoints == 0
        && data.totalMatureTrees == 0;

      // 部署新版前端期間，相容尚未帶入 Shop 欄位的舊版客戶端。
      return hasLegacyShape || hasInitializedShopSummary;
    }

    function changesOnlyEditableUserProfileFields() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'displayName',
          'photoUrl',
          'dailyGoal',
          'onboardingStatus',
          'updatedAt',
          'taskAreaId'
        ]);
    }

    function isValidTestMessage() {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'text',
          'createdAt'
        ])
        && data.keys().hasAll([
          'text',
          'createdAt'
        ])
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 500
        && data.createdAt == request.time;
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create:
        if isOwner(uid)
          && isValidUserProfile()
          && hasValidInitialShopSummary();

      allow update:
        if isOwner(uid)
          && isValidUserProfile()
          && changesOnlyEditableUserProfileFields();

      allow delete: if false;

      match /testMessages/{messageId} {
        allow read:
          if isOwner(uid);

        allow create:
          if isOwner(uid) && isValidTestMessage();

        allow update, delete:
          if false;
      }

      match /taskEnrollments/{taskId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['taskId', 'joinedAt'])
          && request.resource.data.taskId == taskId
          && request.resource.data.joinedAt == request.time
          && get(/databases/$(database)/documents/tasks/$(taskId)).data.cadence == 'event'
          && get(/databases/$(database)/documents/tasks/$(taskId)).data.startsAt <= request.time
          && get(/databases/$(database)/documents/tasks/$(taskId)).data.endsAt > request.time;

        allow update, delete: if false;
      }

      match /taskCompletions/{taskId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /inventory/{documentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /progress/{documentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /dailyProgress/{day} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /ledger/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /commands/{commandId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Internal bonus-game rooms. Every participant is Firebase-authenticated
    // (Google or anonymous quick join); client transactions keep turns atomic.
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.roomMasterId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.roomMasterId == request.auth.uid;

      match /relayGroups/{groupId} {
        allow read, write: if request.auth != null;

        match /pages/{pageId} {
          allow read, write: if request.auth != null;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
