{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "@ionic/angular-toolkit"
    ],
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "client": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "ignore": ["images/pet/motion-studies/**"]
              },
              {
                "glob": "mapbox-gl-csp-worker.js",
                "input": "node_modules/mapbox-gl/dist",
                "output": "assets/mapbox/3.32.0"
              }
            ],
            "styles": [
              "src/styles.scss",
              // TEMP 2026-10-29: restore this line when the CMS iconfont dependency is available.
              // "../cms/node_modules/cub-lib-view-iconfont/css/cub-lib-view-iconfont.min.css",
              "node_modules/mapbox-gl/dist/mapbox-gl.css",
              {
                "input": "@ionic/angular/css/core.css"
              },
              {
                "input": "@ionic/angular/css/normalize.css"
              },
              {
                "input": "@ionic/angular/css/structure.css"
              },
              {
                "input": "@ionic/angular/css/typography.css"
              },
              {
                "input": "@ionic/angular/css/display.css"
              },
              {
                "input": "@ionic/angular/css/padding.css"
              },
              {
                "input": "@ionic/angular/css/float-elements.css"
              },
              {
                "input": "@ionic/angular/css/text-alignment.css"
              },
              {
                "input": "@ionic/angular/css/text-transformation.css"
              },
              {
                "input": "@ionic/angular/css/flex-utils.css"
              },
              {
                "input": "src/theme/variables.css"
              }
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.4MB",
                  "maximumError": "5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "preview": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.4MB",
                  "maximumError": "5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "client:build:production"
            },
            "development": {
              "buildTarget": "client:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "ionic-cordova-serve": {
          "builder": "@ionic/angular-toolkit:cordova-serve",
          "options": {
            "cordovaBuildTarget": "client:ionic-cordova-build",
            "devServerTarget": "client:serve"
          },
          "configurations": {
            "production": {
              "cordovaBuildTarget": "client:ionic-cordova-build:production",
              "devServerTarget": "client:serve:production"
            }
          }
        },
        "ionic-cordova-build": {
          "builder": "@ionic/angular-toolkit:cordova-build",
          "options": {
            "browserTarget": "client:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "client:build:production"
            }
          }
        }
      }
    }
  },
  "schematics": {
    "@ionic/angular-toolkit:component": {
      "styleext": "scss",
      "skipTests": true
    },
    "@ionic/angular-toolkit:page": {
      "styleext": "scss"
    }
  }
}
